# Copia in .env (lo fa `make env`) e adatta. 32 GB totali sul P53:
# lascia margine per il sistema e, più avanti, per HiGlass.
HOST_UID=1000
HOST_GID=1000
LAB_PORT=8888
LAB_MEM=16g
LAB_CPUS=6
WORKER_MEM=6g
WORKER_CPUS=2
OMP_NUM_THREADS=4

# HiGlass (make higlass): utente per registrare i file via API.
# `make env` genera una password casuale se manca.
HIGLASS_PORT=8989
HIGLASS_MEM=6g
HIGLASS_CPUS=4
HIGLASS_WORKERS=4
HIGLASS_USER=clew
HIGLASS_PASSWORD=
